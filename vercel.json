{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "fastapi",
  "buildCommand": "cd web && npm ci && npm run build",
  "functions": {
    "backend/app.py": {
      "maxDuration": 30,
      "excludeFiles": "{research/**,docs/**,pipeline/**,.github/**,web/node_modules/**,web/src/**,**/tests/**,**/__pycache__/**}"
    }
  }
}
